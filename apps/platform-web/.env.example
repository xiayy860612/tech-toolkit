# Base URL of tenant-core-api (called server-side by the BFF only).
TENANT_CORE_API_URL=http://localhost:8080
# Redis holding the Session store (Opaque Token never reaches the browser).
REDIS_URL=redis://localhost:6379
# Session cookie "Secure" flag. Defaults to true when NODE_ENV=production; set false only for plain-http local runs.
SESSION_COOKIE_SECURE=false

# --- E2E only (tests/e2e, see AGENTS.md) ---
E2E_BASE_URL=http://localhost:3000
# Path to the built tenant-core-cli executable used to bootstrap data.
TENANT_CORE_CLI=
E2E_TENANT_SLUG=acme
E2E_USERNAME=admin
# Throw-away test values only; never real passwords.
E2E_INITIAL_PASSWORD=
E2E_NEW_PASSWORD=
