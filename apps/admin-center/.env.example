# 仅占位值；真实值只通过部署环境注入，禁止入库。
# UAM 地址（只在内网可达，且只对 Admin Center 实例开放）
UAM_BASE_URL=http://localhost:8080
# Admin Center 调用 UAM 的服务密钥：用 `generate-service-key --client admin-center` 生成，缺失则服务启动失败
UAM_SERVICE_KEY=
# 调用 UAM 的超时（毫秒）
UAM_TIMEOUT_MS=1500
# 会话 cookie 名；本地 http 开发请改成 asid（__Host- 前缀要求 HTTPS）
SESSION_COOKIE_NAME=__Host-asid
# 取终端来源地址时信任的反向代理跳数
TRUSTED_PROXY_HOPS=1
