# 仅限本地 E2E：固定的测试密钥，禁止用于任何其他环境（预发 / 生产必须用 generate-service-key 生成）。
# 下面的 UAM_CLIENTS 里的哈希就是 UAM_SERVICE_KEY 的 sha256。
POSTGRES_DB=uam
POSTGRES_USER=uam
POSTGRES_PASSWORD=e2e-only-password
UAM_SERVICE_KEY=uamk_e2e_0000000000000000000000000000000000000000
UAM_CLIENTS='[{"id":"admin-center","keyHashes":["sha256:036370eddc1c4169ad277bb1da1a9322cf3b1cae0c49ab79c052ecb91154da3f"],"permissions":["assert-end-user-context"]}]'
# 本地 E2E 走 http，__Host- 前缀要求 HTTPS，所以用 asid
SESSION_COOKIE_NAME=asid
