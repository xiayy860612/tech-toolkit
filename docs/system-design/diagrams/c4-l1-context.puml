@startuml c4-l1-context
' C4 L1 系统上下文。渲染：java -jar plantuml.jar -tsvg -charset UTF-8 docs/system-design/diagrams/*.puml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()

title L1 系统上下文：用户与会话管理系统

Person(operator, "运维人员", "通过浏览器登录，管理用户与会话；本期全部视为受信任的运维人员，不分角色")
System(platform, "用户与会话管理系统", "Admin Center + UAM：登录、User Manager、Session Manager。用户、账号、会话的唯一权威在 UAM；Admin Center 是 UAM 的客户端")
System_Ext(biz, "业务服务（将来）", "将来作为 UAM 的客户端（Client）按需调用；本期没有")
System_Ext(secrets, "密钥管理", "保存服务密钥（UAM_SERVICE_KEY）与客户端清单（UAM_CLIENTS，只含哈希），部署时注入")
System_Ext(obs, "日志与监控平台", "收集结构化日志（含写操作日志）、指标与告警")

Rel(operator, platform, "使用", "浏览器 · HTTPS · 基于会话（cookie）")
Rel(biz, platform, "作为客户端调用 UAM（将来）", "REST · 服务密钥")
Rel(platform, secrets, "读取密钥与配置", "部署期注入")
Rel(platform, obs, "输出日志与指标")
@enduml
