@startuml domain-class
' L3 领域模型：UAM 的 domain 层。会话（Session）存 Redis，其余存 PostgreSQL，见 data-model.md。
title L3 领域模型（UAM domain 层）

hide empty members
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam class {
  BackgroundColor<<聚合根>> #DCE8FF
  BackgroundColor<<实体>> #EEF3FF
  BackgroundColor<<值对象>> #FFF7DC
  BackgroundColor<<策略>> #E8F6EA
  BackgroundColor<<配置>> #F3E8FF
}

package "User 聚合（PostgreSQL）" {
  class User <<聚合根>> {
    id : UserId
    name : String  (1–64，不要求唯一)
    status : UserStatus  {ACTIVE | DISABLED}
    createdAt : Instant
    --
    disable(operator)
    enable()
  }
  class Account <<实体>> {
    id : AccountId
    kind : AccountKind  {PASSWORD}
    loginName : LoginName
    status : AccountStatus  {ACTIVE | DISABLED | DELETED(预留)}
    createdAt : Instant
    --
    canLogin(user) : boolean
  }
  class Credential <<实体>> {
    passwordHash : PasswordHash
    --
    verify(raw) : boolean
    change(current, new)
  }
  class LoginName <<值对象>> {
    raw : String  (3–32)
    normalized : String  (小写，全局唯一)
  }
}

package "Session 聚合（Redis）" {
  class Session <<聚合根>> {
    ref : SessionRef  (非机密)
    accountId : AccountId
    userId : UserId
    loginAt : Instant
    lastActiveAt : Instant
    expiresAt : Instant
    --
    isActive(now) : boolean
  }
}

package "请求上下文与配置（不是业务数据）" {
  class OperatorContext <<值对象>> {
    userId : UserId
    accountId : AccountId
    sessionRef : SessionRef
    --
    请求级：由客户端传入，UAM 信任
  }
  class Client <<配置>> {
    id : String
    keyHashes : sha256[1..2]
    permissions : Set
    --
    部署配置，不入库
  }
}

package "策略（无状态的领域规则）" {
  class AccountNameRules <<策略>> {
    3–32 位字母数字 _ . -，大小写不敏感
  }
  class PasswordPolicy <<策略>> {
    ≥10 位，含字母与数字；改密须不同于当前
  }
  class SessionPolicy <<策略>> {
    空闲 30 分钟 / 绝对 12 小时
  }
  class LoginThrottlePolicy <<策略>> {
    账号 + 来源地址：5 次 / 15 分钟，不锁账号
  }
  class SelfProtectionRule <<策略>> {
    不能停用自己 / 最后一个正常用户
    不能终止自己的会话
  }
}

User "1" *-- "0..*" Account : 拥有
Account "1" *-- "0..1" Credential : 密码账号才有
Account *-- LoginName
Account "1" -- "0..1" Session : 一对一\n（同一账号至多一个有效会话）
Session ..> User : 经账号隶属于唯一用户

Client ..> OperatorContext : 被授予「断言权限」\n才能传入操作人

' 布局提示：策略与请求上下文放在聚合下方，保持版面紧凑
Account -[hidden]down- AccountNameRules
Session -[hidden]down- SessionPolicy
@enduml
