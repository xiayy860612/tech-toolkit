@startuml c4-l3-uam-component
' C4 L3 组件视图：UAM。分层依赖：api → application → domain ← infrastructure（由 ArchUnit 守住）。
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()

title L3 组件视图：UAM

Container(admin, "Admin Center", "Next.js", "UAM 的客户端 admin-center（被授予断言权限）：带服务密钥与 X-Operator-* 请求头")

Container_Boundary(uam, "UAM（Spring Boot 4 · Java 21）") {
  Boundary(api, "api 层") {
    Component(clientAuth, "ClientAuthFilter", "Servlet 过滤器", "校验服务密钥与客户端权限：401 client_unauthenticated / 403 client_forbidden")
    Component(operatorCtx, "OperatorContextResolver", "拦截器", "解析 X-Operator-* 请求头；写操作缺失 → 400 operator_required")
    Component(authApi, "AuthController", "REST", "/v1/auth/login · verify · logout")
    Component(userApi, "UsersController", "REST", "/v1/users：查询、新建、停用、启用")
    Component(sessionApi, "SessionsController", "REST", "/v1/online-users · /v1/users/{id}/sessions · /v1/sessions/{ref}")
    Component(accountApi, "AccountsController", "REST", "/v1/accounts/{id}/password")
  }
  Boundary(app, "application 层") {
    Component(authUc, "认证用例", "Java", "Login · VerifySession · Logout")
    Component(userUc, "用户用例", "Java", "ListUsers · GetUser · CreateUser · DisableUser · EnableUser")
    Component(provisioning, "AccountProvisioningService", "Java", "单事务创建用户 + 账号 + 凭据 / 追加账号；账号名规则与密码策略")
    Component(sessionUc, "会话用例", "Java", "ListOnlineUsers · ListUserSessions · TerminateSession")
    Component(pwUc, "ChangePasswordUseCase", "Java", "校验当前密码与强度；只改指定账号")
  }
  Boundary(dom, "domain 层") {
    Component(domain, "领域模型与规则", "纯 Java，不依赖框架", "User · Account · Credential · Session；策略与端口（见领域模型）")
  }
  Boundary(infra, "infrastructure 层") {
    Component(jdbc, "JDBC 仓储", "Spring JdbcClient", "读写 PostgreSQL：用户、账号、凭据；咨询锁串行化用户状态变更")
    Component(sessionStore, "RedisSessionStore", "Lettuce + Lua", "读写 Redis：会话、在线索引；Lua 原子保证「一账号一会话」")
    Component(redisGuards, "RedisGuards", "Lettuce", "读写 Redis：登录与改密失败限制；创建用户的幂等键")
    Component(hasher, "PasswordHasher", "Argon2id", "密码哈希与自动升级")
    Component(clientReg, "ClientRegistry", "配置 UAM_CLIENTS", "识别客户端：SHA-256 哈希，常量时间比较；至多两把有效密钥；输出客户端 id 与权限")
    Component(writeLog, "WriteOperationLogger", "JSON 日志", "uam.admin.write：客户端、操作人、对象、动作、结果；统一脱敏")
  }
  Boundary(cli, "cli（部署期一次性命令）") {
    Component(cmds, "部署期命令", "Spring Boot cli profile", "init-admin · add-account · generate-service-key")
  }
}

Rel(admin, clientAuth, "HTTP 请求", "REST/JSON · TLS")
Rel(clientAuth, clientReg, "校验服务密钥")
Rel(clientAuth, authApi, "通过后")
Rel(clientAuth, operatorCtx, "通过后")
Rel(operatorCtx, userApi, "附操作人")
Rel(operatorCtx, sessionApi, "附操作人")
Rel(operatorCtx, accountApi, "附操作人")

Rel(authApi, authUc, "调用")
Rel(userApi, userUc, "调用")
Rel(sessionApi, sessionUc, "调用")
Rel(accountApi, pwUc, "调用")

Rel(authUc, domain, "使用")
Rel(userUc, domain, "使用")
Rel(sessionUc, domain, "使用")
Rel(pwUc, domain, "使用")

' 数据库（PostgreSQL、Redis）见 L2；这里只在基础设施组件的描述里标明用到哪一个。
' 依赖倒置：用例只依赖 domain 里的端口，基础设施实现这些端口（运行时由 Spring 装配）。
' 各用例用到哪些端口，见 plan.md 的「用例与端口」表。
Rel(jdbc, domain, "实现端口")
Rel(sessionStore, domain, "实现端口")
Rel(redisGuards, domain, "实现端口")
Rel(hasher, domain, "实现端口")
Rel(writeLog, domain, "实现端口")

Rel(cmds, provisioning, "创建首个用户 / 追加账号")
Rel(userUc, provisioning, "新建用户复用")
Rel(provisioning, domain, "使用")

' 布局提示：基础设施层分两行，避免整张图过宽
Lay_R(jdbc, sessionStore)
Lay_R(sessionStore, redisGuards)
Lay_D(jdbc, hasher)
Lay_R(hasher, writeLog)
Lay_R(writeLog, clientReg)
@enduml
