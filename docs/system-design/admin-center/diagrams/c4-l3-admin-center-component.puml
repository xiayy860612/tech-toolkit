@startuml c4-l3-admin-center-component
' C4 L3 组件视图：Admin Center。lib 下的服务端模块一律 import "server-only"。
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()

title L3 组件视图：Admin Center

Person(operator, "运维人员", "浏览器")
Container(uam, "UAM", "Spring Boot 4", "领域服务")

Container_Boundary(admin, "Admin Center（Next.js 15 · SSR）") {
  Component(mw, "middleware", "Next.js middleware", "设置 CSP nonce 与安全响应头；不发网络请求")
  Component(shell, "Shell 布局", "RSC layout", "读会话三态；已登录渲染侧边栏 + 顶栏，匿名只有顶栏")
  Component(pages, "页面", "RSC", "/users · /users/[id] · /sessions · /sessions/[id] · /account/password · /login")
  Component(actions, "Server Actions", "Next.js", "登录、新建用户、停用、启用、强制下线、修改密码")
  Component(routes, "路由处理器", "Route Handler", "POST /logout · GET /session/expire")
  Component(session, "getSession", "lib/session", "读 cookie → verify；三态 authenticated / anonymous / unverified")
  Component(origin, "OriginCheck", "lib/security", "同源校验（CSRF）")
  Component(valid, "表单校验", "zod", "字段级校验与原因提示")
  Component(clientip, "ClientIp", "lib/session", "按可信代理跳数取终端来源地址")
  Component(uamClient, "UamClient", "lib/uam", "带 X-Operator-* 调用 UAM；错误码 → 界面文案；超时 1.5 秒")
  Component(ui, "UI 组件", "shadcn/ui + Tailwind", "表格 / 卡片、对话框、侧边栏、抽屉")
  Component(cookie, "cookie", "lib/session", "读 / 写 / 清除会话 cookie：HttpOnly; Secure; SameSite=Strict; Path=/，不设 Domain")
  Component(config, "config · instrumentation", "lib/config · src/instrumentation.ts", "zod 解析环境变量（运行期解析，不在构建期）；服务启动时校验：缺 UAM_BASE_URL 即启动失败")
}

Rel(operator, mw, "请求", "HTTPS · cookie")
Rel(mw, shell, "转交")
Rel(shell, session, "读取会话三态")
Rel(shell, pages, "渲染")
Rel(pages, ui, "使用")
Rel(pages, uamClient, "查询数据")
Rel(operator, actions, "表单提交", "POST")
Rel(actions, origin, "同源校验")
Rel(actions, valid, "校验输入")
Rel(actions, clientip, "取来源地址")
Rel(actions, uamClient, "执行写操作")
Rel(routes, origin, "POST /logout 同源校验")
Rel(routes, cookie, "清除 cookie")
Rel(actions, cookie, "登录写 cookie")
Rel(session, cookie, "读 cookie")
Rel(routes, session, "重新校验后清 cookie")
Rel(routes, uamClient, "logout")
Rel(session, uamClient, "verify")
Rel(uamClient, uam, "调用", "REST/JSON · TLS")
Rel(uamClient, config, "读取配置")
@enduml
