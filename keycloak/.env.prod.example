# 生产形态（docker-compose.prod.yml）环境变量；复制为 .env.prod 后填写，.env.prod 不入库。
KEYCLOAK_VERSION=26.4

# 对外访问地址（含协议；非默认端口要带端口）
# 生产：KC_HOSTNAME=https://oidc.s2u2m.com
# 本地验证：KC_HOSTNAME=https://localhost:8443
KC_HOSTNAME=https://localhost:8443

# 宿主机暴露的 HTTPS 端口（映射到容器 8443）；生产用 443，本地验证用 8443 避免特权端口
KEYCLOAK_HTTPS_PORT=8443

# TLS 证书目录，内含 tls.crt（含完整证书链）与 tls.key；生产指向真实证书目录
TLS_CERT_DIR=./certs

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# 内置 PostgreSQL：库与账号由容器首次启动时按下列值自动创建（之后改密码需在库里 ALTER ROLE）
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-db

# 可选：镜像源覆盖。国内 VM 访问 quay.io / Docker Hub 不稳定时，改成自己镜像仓库（如腾讯云 TCR）中的地址
# KEYCLOAK_BASE_IMAGE=quay.io/keycloak/keycloak:26.4
# POSTGRES_IMAGE=postgres:18-alpine
