# 生产形态（docker-compose.prod.yml）环境变量；复制为 .env.prod 后填写，.env.prod 不入库。
KEYCLOAK_VERSION=26.4

# 对外访问地址（含协议与非默认端口）与 nginx server_name
# 生产示例：KC_HOSTNAME=https://sso.example.com   SERVER_NAME=sso.example.com
# 本地验证：KC_HOSTNAME=https://localhost:8443    SERVER_NAME=localhost
KC_HOSTNAME=https://localhost:8443
SERVER_NAME=localhost

# 宿主机暴露端口；生产用 443/80，本地验证用 8443/8081 避免特权端口
PROXY_HTTPS_PORT=8443
PROXY_HTTP_PORT=8081

# TLS 证书目录，内含 tls.crt 与 tls.key；生产指向真实证书目录
TLS_CERT_DIR=./certs

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# 已存在的 PostgreSQL（库与账号需预先创建）
# 本地验证：KC_DB_HOST=host.docker.internal（指向宿主机上的 Postgres）
KC_DB_HOST=host.docker.internal
KC_DB_PORT=5432
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-db
# 可选 JDBC 参数，如生产要求 TLS：?sslmode=require
KC_DB_URL_PARAMS=
