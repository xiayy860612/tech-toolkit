# 仅示例值；真实环境通过环境变量/密钥管理注入，切勿提交真实密钥
BACKEND_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379

# 本期固定默认租户（无租户管理，登录页无租户入口）
DEFAULT_TENANT_ID=0

SESSION_COOKIE_NAME=SESSION_ID
# resolve 结果的内存缓存 TTL（秒）；0 关闭缓存
SESSION_RESOLVE_CACHE_TTL_SECONDS=5

# 内部 JWT：私钥 JWK 文件由 `pnpm keys` 生成到 .keys/（已被 .gitignore 忽略）
INTERNAL_JWT_PRIVATE_KEY_PATH=./.keys/internal-jwt-private.jwk.json
INTERNAL_JWT_ISSUER=admin-center-bff
INTERNAL_JWT_AUDIENCE=tenant-core-api
INTERNAL_JWT_TTL_SECONDS=60

# 信任的反向代理层数；0 = 不信任 X-Forwarded-For，直接取连接地址
TRUSTED_PROXY_HOPS=0

# 登录限流：每窗口每 IP 的最大次数与窗口秒数
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# 开发环境（非 https）下设为 false，使 Cookie 不带 Secure；生产必须为 true
COOKIE_SECURE=true
