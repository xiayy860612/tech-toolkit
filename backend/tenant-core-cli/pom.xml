<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>tech.toolkit.tenantcore</groupId>
    <artifactId>tenant-core-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tenant-core-cli</artifactId>
  <name>tenant-core-cli</name>
  <description>Bootstrap CLI: create Tenant, enable Login Method, create User and Account, subscribe Module.</description>

  <dependencies>
    <dependency>
      <groupId>tech.toolkit.tenantcore</groupId>
      <artifactId>core-lib</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>

    <dependency>
      <groupId>tech.toolkit.tenantcore</groupId>
      <artifactId>core-lib</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- PackagedCliSmokeIT needs the packaged jar, so it runs after `package` (integration-test phase) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/PackagedCliSmokeIT.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>packaged-cli-smoke</id>
            <phase>integration-test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/PackagedCliSmokeIT.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- executable jar: java -jar tenant-core-cli.jar <command> (see bin/tenant-core-cli) -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>tech.toolkit.tenantcore.cli.TenantCoreCliMain</mainClass>
          <finalName>tenant-core-cli</finalName>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
