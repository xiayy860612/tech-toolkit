<?xml version="1.0" encoding="UTF-8"?>
<!-- CLI logging: warnings and errors to stderr; secrets that slip into a message are masked. -->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{20} - %replace(%msg){'(?i)(password|passwd|secret|token)(=|:)\s*\S+', '$1$2***'}%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
