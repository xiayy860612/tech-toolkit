# Copy to .env (never commit .env). All values below are placeholders.

# --- PostgreSQL ---
TENANT_CORE_DB_HOST=localhost
TENANT_CORE_DB_PORT=5432
TENANT_CORE_DB_NAME=tenant_core
# Owner role: runs Flyway migrations (API start-up and CLI)
TENANT_CORE_DB_OWNER_USER=tenant_core
TENANT_CORE_DB_OWNER_PASSWORD=change-me-owner
# Application role: runtime access; cannot UPDATE/DELETE audit_event
TENANT_CORE_DB_APP_USER=tenant_core_app
TENANT_CORE_DB_APP_PASSWORD=change-me-app

# --- UAM (Internal JWT) ---
UAM_ISSUER=https://uam.platform.example.internal
UAM_AUDIENCE=platform-services
UAM_CELL_ID=platform-1
UAM_JWT_TTL_SECONDS=120
# ES256 private key in PEM (PKCS#8). Required unless the `dev` Spring profile is active
# (dev generates an ephemeral key). Mount from a secret; never commit a key.
UAM_SIGNING_KEY_PEM=

# --- API ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
