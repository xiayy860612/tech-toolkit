# 仅示例值；真实环境通过环境变量/密钥管理注入，切勿提交真实密钥
DB_URL=jdbc:postgresql://localhost:5432/tenantcore
DB_APP_USER=tenantcore_app
DB_APP_PASSWORD=change-me
DB_MIGRATION_USER=tenantcore
DB_MIGRATION_PASSWORD=change-me

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_RETENTION_DAYS=7

INTERNAL_JWT_ISSUER=admin-center-bff
INTERNAL_JWT_AUDIENCE=tenant-core-api
INTERNAL_JWT_PUBLIC_KEY_PATH=../.keys/internal-jwt-public.pem
INTERNAL_JWT_CLOCK_SKEW_SECONDS=30
