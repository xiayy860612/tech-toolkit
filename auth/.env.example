# Copy to .env (git-ignored) and fill in. Never commit real values.

# Database: the owner role runs Flyway migrations, the app role serves requests
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth
AUTH_DB_OWNER_USER=auth_owner
AUTH_DB_OWNER_PASSWORD=change-me-owner
AUTH_DB_APP_USER=auth_app
AUTH_DB_APP_PASSWORD=change-me-app

# Issuer URL, fixed by configuration
AUTH_ISSUER=http://localhost:9000

# ES256 signing keys: PEM files, comma-separated. The first is the current signing key;
# the rest are verify-only (published in JWKS during rotation). The dev profile may omit this.
AUTH_SIGNING_KEYS=/run/secrets/auth-signing-current.pem,/run/secrets/auth-signing-previous.pem

# Loopback redirect URIs of the `auth-admin` client registered by the bootstrap command (comma-separated)
AUTH_ADMIN_REDIRECT_URIS=http://127.0.0.1:8765/callback

# Client secrets for dev example clients are generated at startup in the dev profile; production clients are
# registered through the admin API and their secrets are shown once.
